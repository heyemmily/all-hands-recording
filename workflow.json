{
  "name": "All Hands Recording Auto-Poster",
  "nodes": [
    {
      "parameters": {
        "resource": "recording",
        "events": ["recordingAdded"],
        "filters": {}
      },
      "id": "grain-trigger",
      "name": "New Grain Recording",
      "type": "n8n-nodes-base.grainTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "webhookId": "grain-recording-webhook",
      "credentials": {
        "grainApi": {
          "id": "REPLACE_WITH_GRAIN_CREDENTIAL_ID",
          "name": "Grain account"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "channel": {
          "__rl": true,
          "mode": "name",
          "value": "#general"
        },
        "text": "=<!channel> Hi all — Here's the All Hands Recording, for those who weren't able to join!\n\n{{ $json.recording.url }}",
        "otherOptions": {}
      },
      "id": "post-to-slack",
      "name": "Post to #general",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [220, 0],
      "credentials": {
        "slackApi": {
          "id": "REPLACE_WITH_SLACK_CREDENTIAL_ID",
          "name": "Slack account"
        }
      }
    }
  ],
  "connections": {
    "New Grain Recording": {
      "main": [
        [
          {
            "node": "Post to #general",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": true
  }
}
